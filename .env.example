# Azure Communication Services
# Variables legacy retiradas: AZURE_COMMUNICATION_ENDPOINT y AZURE_COMMUNICATION_KEY.
# Ya no se usan; si siguen presentes en tu .env, se ignoran sin efecto.
AZURE_EMAIL_CONNECTION_STRING="endpoint=https://.............communication.azure.com/;accesskey=Vz............"

FROM_EMAIL="DoNotReply........."

# Opcional: destinatario de las alertas por fallo definitivo del pipeline (default: FROM_EMAIL)
ALERT_EMAIL="alertas@tu-dominio.com"

# Google Cloud
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "tu-proyecto", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "...", "client_id": "..."}
DRIVE_FILE_ID=1A2B3C4D5E6F7G8H9I0J_ejemplo_id

# Negocio
BOOKING_URL=https://calendly.com/tu-enlace/reunion

# Correo del lead (branding)
# URL pública del monograma blanco (PNG). Default: raw GitHub del isotipo blanco;
# migrar al dominio de marca cuando exista el deploy de la landing.
LEAD_EMAIL_LOGO_URL=https://raw.githubusercontent.com/dsalazardev/salazar-eng-landing/main/public/isotipo-white.png
# Enlace de WhatsApp mostrado en el footer del correo del lead
LEAD_EMAIL_WHATSAPP_URL=https://wa.me/573145919465

# Pipeline
# Tamaño máximo del PDF adjuntado (en MB)
MAX_PDF_SIZE_MB=10

# Rate limiting del endpoint /lead (formato limits, p. ej. "5/minute")
RATE_LIMIT_LEAD=5/minute

# Logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

#Cors
# .env (Desarrollo local)
CORS_ORIGINS=["http://localhost:4321","http://localhost:3000"]
